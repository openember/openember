mainmenu "OpenEmber Configuration"

menu "Build / Toolchain"

config OPENEMBER_CROSSCOMPILE_ENABLED
    bool "Enable cross compile mode (aarch64)"
    default n

config OPENEMBER_DEBUG_ENABLED
    bool "Debug build"
    default y

config OPENEMBER_OPTIMIZATION_DISABLED
    bool "Disable optimization"
    default n

config OPENEMBER_ENABLE_OPENMP
    bool "Enable OpenMP"
    default n

choice OPENEMBER_THIRD_PARTY_MODE_CHOICE
    prompt "Third-party mode"
    default OPENEMBER_TP_MODE_FETCH

config OPENEMBER_TP_MODE_FETCH
    bool "FetchContent"

config OPENEMBER_TP_MODE_VENDOR
    bool "Vendor (third_party/ archives + optional PAHO_MQTT_C_LOCAL_SOURCE, see docs)"

config OPENEMBER_TP_MODE_SYSTEM
    bool "System packages"

endchoice

endmenu

