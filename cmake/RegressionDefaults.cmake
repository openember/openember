# Initial cache for a separate host regression build; does not load Kconfig.
set(TESTS_ENABLED ON CACHE BOOL "Build regression tests")
set(OPENEMBER_REGRESSION_BASELINE ON CACHE BOOL "Require the full regression baseline")
foreach(_feature
        ENABLE_LINK ENABLE_MSGS ENABLE_OSAL COMPONENT_ALGORITHM
        COMPONENT_HARDWARE COMPONENT_SENSOR COMPONENT_ACTUATOR
        COMPONENT_TRANSPORT SERVICE_HARDWARE_INTERFACE SYSTEM_LAUNCH_MANAGER
        HARDWARE_ENDPOINT_IMU HARDWARE_ENDPOINT_TEMPERATURE
        HARDWARE_ENDPOINT_GNSS HARDWARE_ENDPOINT_JOINT_CONTROLLER
        EXAMPLE_HARDWARE_INTERFACE WITH_YAMLCPP)
    set(OPENEMBER_${_feature} ON CACHE BOOL "Regression dependency")
endforeach()
set(EXAMPLES_ENABLED ON CACHE BOOL "Build hardware regression examples")
foreach(_feature
        COMPONENT_MQTT SERVICE_WEB_CONSOLE SERVICE_OTA_AGENT SERVICE_LOGGER
        EXAMPLE_MQTT_EMQX EXAMPLE_HELLO_NODE EXAMPLE_CORE EXAMPLE_TRANSPORT
        EXAMPLE_NETWORK_SOCKETS REFERENCE_SENSOR_DATA ENABLE_TOOLS)
    set(OPENEMBER_${_feature} OFF CACHE BOOL "Not needed by regression baseline")
endforeach()
