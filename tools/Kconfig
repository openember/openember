menu "Tools"

config OPENEMBER_ENABLE_TOOLS_GAMEPAD_MONITOR
    bool "Build F710 XInput monitor"
    depends on OPENEMBER_ENABLE_TOOLS && OPENEMBER_COMPONENT_REMOTE_CONTROL
    default y
    help
      Read-only Linux evdev monitor. No actuator or transport dependency.

config OPENEMBER_ENABLE_TOOLS
    bool "Build OpenEmber utilities (tools/)"
    default y
    help
      Host-side command-line utilities shipped with OpenEmber.
      Individual tools may require platform libraries (e.g. LPIO).

config OPENEMBER_ENABLE_TOOLS_EMCOM
    bool "Build emcom (picocom-like serial console)"
    depends on OPENEMBER_ENABLE_TOOLS
    depends on OPENEMBER_ENABLE_LPIO
    default y
    help
      Interactive serial terminal using LPIO SerialPort.
      Installed as executable emcom. Requires OPENEMBER_ENABLE_LPIO.

config OPENEMBER_ENABLE_TOOLS_SBUS_RECEIVER
    bool "Build sbus-receiver (SBUS channel monitor)"
    depends on OPENEMBER_ENABLE_TOOLS
    depends on OPENEMBER_ENABLE_LPIO
    default y
    help
      Receive Futaba SBUS frames and print PWM / switch channels.
      Installed as executable sbus-receiver. Requires OPENEMBER_ENABLE_LPIO.

endmenu
