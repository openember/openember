menu "Services"

config OPENEMBER_SERVICE_OTA_AGENT
    bool "Build service: ota_agent"
    default y

config OPENEMBER_SERVICE_WEB_CONSOLE
    bool "Build service: web_console"
    default y

config OPENEMBER_WEB_CONSOLE_ROOT_DIR
    string "web_console web root directory"
    default "services/web_console/web_root"
    depends on OPENEMBER_SERVICE_WEB_CONSOLE
    help
      Default web root directory for web_console.
      If a relative path is used, CMake will treat it as relative to the repository root.

config OPENEMBER_WEB_CONSOLE_PORT
    int "web_console HTTP port"
    default 8000
    range 1 65535
    depends on OPENEMBER_SERVICE_WEB_CONSOLE
    help
      HTTP listen port for web_console. Server binds to 0.0.0.0:<port>.

config OPENEMBER_SERVICE_LOGGER
    bool "Build service: logger"
    default y

config OPENEMBER_LOGGER_PORT
    int "logger HTTP port (local)"
    default 18081
    range 1 65535
    depends on OPENEMBER_SERVICE_LOGGER
    help
      Local listen port for logger service, typically bound to 127.0.0.1.

config OPENEMBER_LOGGER_LOG_DIR
    string "logger source log directory"
    default "/var/log/openember"
    depends on OPENEMBER_SERVICE_LOGGER
    help
      Directory where logger scans *.log files generated by process log sinks.

endmenu
