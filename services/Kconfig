menu "Services"

config OPENEMBER_SERVICE_HARDWARE_INTERFACE
    bool "Build service: hardware_interface"
    default y
    depends on OPENEMBER_ENABLE_LINK
    depends on OPENEMBER_ENABLE_MSGS
    depends on OPENEMBER_COMPONENT_SENSOR
    depends on OPENEMBER_USE_YAMLCPP
    help
      Build the OpenEmber Hardware Interface runtime service. The V1 service
      manages configured sensor endpoints and publishes samples, heartbeat,
      devices, and diagnostics through OpenEmber Link. The service can load
      its endpoint topology from a local YAML file.

if OPENEMBER_SERVICE_HARDWARE_INTERFACE

menu "Hardware Interface Endpoints"

config OPENEMBER_HARDWARE_ENDPOINT_IMU
    bool "IMU"
    default y
    depends on OPENEMBER_COMPONENT_SENSOR

config OPENEMBER_HARDWARE_ENDPOINT_TEMPERATURE
    bool "Temperature"
    default y
    depends on OPENEMBER_COMPONENT_SENSOR

config OPENEMBER_HARDWARE_ENDPOINT_GNSS
    bool "GNSS"
    default y
    depends on OPENEMBER_COMPONENT_SENSOR

config OPENEMBER_HARDWARE_ENDPOINT_JOINT_CONTROLLER
    bool "Joint Controller"
    default n
    depends on OPENEMBER_COMPONENT_ACTUATOR
    help
      Build the first actuator endpoint for JointController command/state
      loop testing. V1 uses MockJointController and is disabled by default
      until a product explicitly opts into actuator endpoint validation.

endmenu

endif

config OPENEMBER_SERVICE_OTA_AGENT
    bool "Build service: ota_agent"
    default y

config OPENEMBER_SERVICE_WEB_CONSOLE
    bool "Build service: web_console"
    default y

config OPENEMBER_WEB_CONSOLE_ROOT_DIR
    string "web_console web root directory"
    default "services/web_console/web_root"
    depends on OPENEMBER_SERVICE_WEB_CONSOLE
    help
      Default web root directory for web_console.
      If a relative path is used, CMake will treat it as relative to the repository root.

config OPENEMBER_WEB_CONSOLE_PORT
    int "web_console HTTP port"
    default 8000
    range 1 65535
    depends on OPENEMBER_SERVICE_WEB_CONSOLE
    help
      HTTP listen port for web_console. Server binds to 0.0.0.0:<port>.

config OPENEMBER_SERVICE_LOGGER
    bool "Build service: logger"
    default y

config OPENEMBER_LOGGER_PORT
    int "logger HTTP port (local)"
    default 18081
    range 1 65535
    depends on OPENEMBER_SERVICE_LOGGER
    help
      Local listen port for logger service, typically bound to 127.0.0.1.

config OPENEMBER_LOGGER_LOG_DIR
    string "logger source log directory"
    default "/var/log/openember"
    depends on OPENEMBER_SERVICE_LOGGER
    help
      Directory where logger scans *.log files generated by process log sinks.

endmenu
