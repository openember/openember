# Framework baseline for a product workspace. Model fragments override this.
CONFIG_OPENEMBER_ENABLE_LINK=y
CONFIG_OPENEMBER_ENABLE_MSGS=y
CONFIG_OPENEMBER_APP_TURTLE_DEMO=n
CONFIG_OPENEMBER_APP_SMART_DEVICE_DEMO=n
CONFIG_OPENEMBER_ENABLE_EXAMPLES=n
CONFIG_OPENEMBER_ENABLE_TESTS=n
CONFIG_OPENEMBER_ENABLE_TOOLS=n
# Only the supervisor is required by the demo launch topology. Other services
# remain selectable in menuconfig and are built normally when enabled.
CONFIG_OPENEMBER_SYSTEM_LAUNCH_MANAGER=y
CONFIG_OPENEMBER_SYSTEM_LOG_SERVICE=n
CONFIG_OPENEMBER_SYSTEM_DEVICE_MANAGER=n
CONFIG_OPENEMBER_SYSTEM_CONFIG_SERVICE=n
CONFIG_OPENEMBER_SYSTEM_HEALTH_MONITOR=n
CONFIG_OPENEMBER_SERVICE_OTA_AGENT=n
CONFIG_OPENEMBER_SERVICE_WEB_CONSOLE=n
CONFIG_OPENEMBER_SERVICE_LOGGER=n
CONFIG_OPENEMBER_SERVICE_HOST_MONITOR=n
CONFIG_OPENEMBER_SERVICE_HARDWARE_INTERFACE=n
